{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "9d1ca5329918e495aa0b71c99de6369a",
  "name": "martinsrealestate",
  "main": "worker.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/blog",
      "/blog/*",
      "/employee",
      "/employee/*",
      "/media/*"
    ]
  },
  "vars": {
    "SITE_URL": "https://martinsrealestate.co"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "martins-blog",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "martins-blog-media"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "martinsrealestate@msn.com",
      "allowed_sender_addresses": ["website@martinsrealestate.co"]
    }
  ]
}
